datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  email           String         @unique
  passwordHash    String
  emailVerified   DateTime?
  role            String         @default("USER") // USER, ADMIN
  status          String         @default("ACTIVE") // ACTIVE, BANNED
  isOnline        Boolean        @default(false)
  lastActive      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile         Profile?
  photos          Photo[]
  likesSent       Like[]         @relation("LikesSent")
  likesReceived   Like[]         @relation("LikesReceived")
  matches1        Match[]        @relation("MatchUser1")
  matches2        Match[]        @relation("MatchUser2")
  messagesSent    Message[]
  notifications   Notification[]
  subscription    Subscription?
  payments        Payment[]
  reportsFiled    Report[]       @relation("Reporter")
  reportsReceived Report[]       @relation("Reported")
  blockedUsers    BlockedUser[]  @relation("Blocker")
  blockedBy       BlockedUser[]  @relation("Blocked")
  favorites       Favorite[]     @relation("UserFavorites")
  favoritedBy     Favorite[]     @relation("FavoritedUsers")
  settings        Settings?
  activityLogs    ActivityLog[]
  comments        Comment[]      @relation("UserComments")
}

model Profile {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @unique @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName         String?
  username         String?   @unique
  gender           String?   // Male, Female, Other
  interestedIn     String?   // Male, Female, Everyone
  dob              DateTime?
  age              Int?
  height           Float?    // in cm or ft
  weight           Float?    // in kg or lbs
  religion         String?
  profession       String?
  education        String?
  country          String?
  city             String?
  languages        String[]  @default([])
  relationshipGoal String?   // Short-term, Long-term, Marriage, Friendship, Casual
  bio              String?
  hobbies          String[]  @default([])
  smoking          String?   // Non-smoker, Social Smoker, Smoker
  drinking         String?   // Non-drinker, Social Drinker, Heavy Drinker
  pets             String[]  @default([])
  favoriteMusic    String[]  @default([])
  favoriteMovies   String[]  @default([])
  instagram        String?
  facebook         String?
  occupation       String?
  lookingFor       String?
  personalityType  String?   // e.g. INTJ, ENFP
  phoneNumber      String?
  completed        Boolean   @default(false)
  
  premiumStatus    String    @default("FREE") // FREE, GOLD, PLATINUM
  premiumUntil     DateTime?
  verificationBadge Boolean  @default(false)
}

model Photo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  isProfile Boolean  @default(false)
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  swiperId  String   @db.ObjectId
  swipedId  String   @db.ObjectId
  swiper    User     @relation("LikesSent", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped    User     @relation("LikesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  type      String   // LIKE, PASS, SUPERLIKE
  createdAt DateTime @default(now())

  @@unique([swiperId, swipedId])
}

model Match {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String   @db.ObjectId
  user2Id   String   @db.ObjectId
  user1     User     @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model Conversation {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  user1Id         String    @db.ObjectId
  user2Id         String    @db.ObjectId
  lastMessageText String?
  lastMessageAt   DateTime  @default(now())
  messages        Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String?
  imageUrl       String?
  audioUrl       String?
  isSms          Boolean      @default(false)
  status         String       @default("SENT") // SENT, DELIVERED, READ
  createdAt      DateTime     @default(now())
  repliedToId    String?      @db.ObjectId
  reactions      String[]     @default([]) // e.g. "❤️:userId"
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // LIKE, MATCH, MESSAGE, PROFILE_VIEW, CALL_REQUEST
  content   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscription {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  userId               String    @unique @db.ObjectId
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType             String    // GOLD, PLATINUM
  status               String    // ACTIVE, CANCELLED, EXPIRED
  expiresAt            DateTime
  stripeSubscriptionId String?
}

model Payment {
  id                     String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String   @db.ObjectId
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                 Float
  status                 String   // PENDING, SUCCESS, FAILED
  stripePaymentIntentId String?
  createdAt              DateTime @default(now())
}

model Report {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  reporterId  String   @db.ObjectId
  reportedId  String   @db.ObjectId
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      String
  description String?
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
}

model BlockedUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String   @db.ObjectId
  blockedId String   @db.ObjectId
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Favorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  favoriteId String   @db.ObjectId
  user       User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  favorite   User     @relation("FavoritedUsers", fields: [favoriteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, favoriteId])
}

model VerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expiresAt DateTime
  type      String   // EMAIL_VERIFICATION, PASSWORD_RESET

  @@unique([email, token])
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // LOGIN, SWIPE, PROFILE_UPDATE, CHAT
  details   String?
  createdAt DateTime @default(now())
}

model Settings {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @unique @db.ObjectId
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  darkMode           Boolean @default(true)
  pushNotifications  Boolean @default(true)
  emailNotifications Boolean @default(true)
  invisibleMode      Boolean @default(false)
  privatePhotos      Boolean @default(false)
}

model Comment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  targetId    String   // Candidate / post user ID
  authorId    String?  @db.ObjectId
  author      User?    @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  authorName  String
  authorPhoto String?
  text        String
  createdAt   DateTime @default(now())
}

